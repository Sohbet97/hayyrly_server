# Server
PORT=3000
NODE_ENV=development
# LOG_LEVEL=debug   # winston level: error|warn|info|debug (defaults to debug in dev, info in prod)

# Postgres (app_data schema — mobile + admin tables, Sequelize)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=hayyrly
DB_USER=postgres
DB_PASSWORD=

# Postgres (read-only GIS DB used by server/models/mapModel.js)
MAP_DB_HOST=localhost
MAP_DB_PORT=5433
MAP_DB_NAME=hayyrly_gis
MAP_DB_USER=postgres
MAP_DB_PASSWORD=

# Redis (taxi location cache / pub-sub)
REDIS_URL=redis://localhost:6379

# Auth
# Shared secret for both mobile and admin JWTs (admin tokens carry typ:"admin")
JWT_SECRET=change-me
OTP_SECRET=change-me

# Order pricing fallback (used when a city has no pricing_config row)
ORDER_BASE_PRICE=5
ORDER_PRICE_PER_KM=1.5

# Firebase — service account file, not an env var:
#   server/firebase/service_acount.json (see firebase-admin config in config/firebase.js)

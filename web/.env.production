# Map server base used by the production build (see src/components/map/LiveMap.jsx).
# The panel is deployed on hayyrly.com.tm, so this is same-origin — no CORS needed.
# If the panel ever moves to another domain, keep this pointing at the map server
# and enable CORS on it (Access-Control-Allow-Origin) for tiles/fonts/catalog.
VITE_MAP_BASE=https://hayyrly.com.tm

# Backend API base used by the production build (see src/api/client.js).
# Same-origin deployment on hayyrly.com.tm — no CORS needed.
VITE_API_BASE=https://hayyrly.com.tm

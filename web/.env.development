# Base URL of the map server (Martin tiles, fonts, style.json, OSRM).
# Left unset for local dev — the Vite proxy (vite.config.js) forwards
# /map-styles, /map, /fonts, /osrm to https://hayyrly.com.tm.
VITE_MAP_BASE=

# Base URL of the backend REST/Socket.IO API (server/).
# Left unset for local dev — the Vite proxy forwards /api and /socket.io to
# http://localhost:3000. Setting this to an absolute URL forces cross-origin
# requests from localhost:5173, which the backend does not send CORS headers
# for and the browser will block.
VITE_API_BASE=

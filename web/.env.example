# Base URL of the map server (Martin tiles, fonts, style.json, OSRM).
# Leave unset for local dev — the Vite proxy handles it via the current origin.
# In production it defaults to https://hayyrly.com.tm; override here if needed.
VITE_MAP_BASE=https://hayyrly.com.tm

# Base URL of the backend REST/Socket.IO API (server/).
# Leave unset for local dev — the Vite proxy forwards /api and /socket.io to
# http://localhost:3000. In production it defaults to https://hayyrly.com.tm.
VITE_API_BASE=
